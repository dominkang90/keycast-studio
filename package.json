{
  "name": "keycast-studio",
  "productName": "KeyCast Studio",
  "version": "1.0.0",
  "description": "Screen recorder that shows every key you press, polishes clicks with auto-zoom and turns your voice into subtitles.",
  "license": "MIT",
  "author": "dominkang90",
  "homepage": "https://github.com/dominkang90/keycast-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominkang90/keycast-studio.git"
  },
  "bugs": {
    "url": "https://github.com/dominkang90/keycast-studio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "build:ui": "vite build",
    "build:web": "vite build --config vite.web.config.js",
    "package": "electron-packager . \"KeyCast Studio\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --ignore=^/src --ignore=^/release --ignore=^/tests --ignore=^/web/ --ignore=^/vite\\..*config\\.js$ --ignore=\\.cmd$ --ignore=\\.lnk$ --ignore=^/docs --ignore=\\.md$ && node tests/check-package.cjs",
    "build": "npm run build:ui && npm run build:web && npm run package",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@huggingface/transformers": "^3.7.0",
    "electron": "^33.2.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "webm-muxer": "^5.1.4"
  }
}
